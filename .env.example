# Application
NODE_ENV=development
PORT=3000
FRONTEND_ORIGINS=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=schoolyshop
DB_SSL=false

# Biteship (opsional; tanpa API key memakai data pengiriman lokal)
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_ORIGIN_AREA_ID=
BITESHIP_ORIGIN_POSTAL_CODE=
BITESHIP_ORIGIN_CONTACT_NAME=Koperasi Sekolah
BITESHIP_ORIGIN_CONTACT_PHONE=081200000000
BITESHIP_ORIGIN_ADDRESS=Koperasi Sekolah
BITESHIP_COURIERS=jne,sicepat,jnt,anteraja
BITESHIP_WEBHOOK_HEADER_KEY=x-biteship-webhook-secret
BITESHIP_WEBHOOK_SECRET=

# Midtrans (opsional; tanpa server key memakai simulasi pembayaran lokal)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_BASE_URL=
