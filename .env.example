# Application
NODE_ENV=development
PORT=3000
FRONTEND_ORIGINS=http://localhost:5173

# PostgreSQL (dipakai bila DATABASE_URL kosong)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=schoolyshop
DB_SSL=false

# Neon/cloud Postgres: pooled untuk runtime, direct untuk migration Drizzle.
# Bila DATABASE_URL diisi, variabel DB_* di atas tidak wajib.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Neon Object Storage / S3-compatible (opsional; tanpa kredensial memakai disk lokal)
# Isi kelimanya bersamaan. Bucket public_read agar URL file langsung terbaca.
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Biteship (opsional; tanpa API key memakai data pengiriman lokal)
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_ORIGIN_AREA_ID=
BITESHIP_ORIGIN_POSTAL_CODE=
BITESHIP_ORIGIN_CONTACT_NAME=Koperasi Sekolah
BITESHIP_ORIGIN_CONTACT_PHONE=081200000000
BITESHIP_ORIGIN_ADDRESS=Koperasi Sekolah
BITESHIP_COURIERS=jne,sicepat,jnt,anteraja
BITESHIP_WEBHOOK_HEADER_KEY=x-biteship-webhook-secret
BITESHIP_WEBHOOK_SECRET=

# Midtrans (opsional; tanpa server key memakai simulasi pembayaran lokal)
# Server Key hanya untuk Authorization API. Signature Key opsional untuk verifikasi webhook; fallback ke Server Key bila kosong.
MIDTRANS_SERVER_KEY=
MIDTRANS_SIGNATURE_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_BASE_URL=
